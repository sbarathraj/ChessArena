{
  "expo": {
    "name": "ChessArena",
    "slug": "chess-arena",
    "owner": "sbarathrajs-team",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "chessarena",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#161512"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chessarena.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#161512"
      },
      "package": "com.chessarena.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b0d5ce92-cb37-4e2e-b2f9-839689a29adc"
      }
    }
  }
}
